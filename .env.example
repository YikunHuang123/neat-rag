# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8058
API_URL=http://localhost:8058

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vector_db

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

LLM_MODEL=gpt-4o-mini

# ── Retrieval Embedding ───────────────────────────────────────────────────────
# Which provider to use for retrieval (storage + query time must use the same model).
# Options: openai (default), gemini, ollama, custom
EMBEDDING_PROVIDER=openai

# Recommended combinations:
# OpenAI: EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
# Gemini: EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIM=3072
# Ollama: EMBEDDING_MODEL=nomic-embed-text, EMBEDDING_DIM=768
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# For EMBEDDING_PROVIDER=custom — point at any OpenAI-compatible endpoint:
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=none

# ── Semantic Chunking Embedding ───────────────────────────────────────────────
# Only used when chunking_strategy=semantic. Can differ from EMBEDDING_MODEL.
CHUNKING_MODEL=text-embedding-3-small
# If you are using Gemini for chunking, you MUST configure the base URL:
# CHUNKING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHUNKING_API_KEY=your_gemini_key_here
#
# To use a local model for chunking (Ollama, llama.cpp, vLLM, etc.):
# CHUNKING_BASE_URL=http://localhost:11434/v1
# CHUNKING_API_KEY=ollama


# ── Local Ollama ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security & Rate Limiting ──────────────────────────────────────────────────
# Set ENABLE_AUTH=true in production; create your first key via POST /admin/keys
ENABLE_AUTH=false
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=10/minute
