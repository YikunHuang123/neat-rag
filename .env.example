# Neat-RAG — minimum configuration to get started.
# Copy to .env and fill in your values:  cp .env.example .env
#
# For the full list of tuneable settings (retrieval, chunking, rate limits, etc.)
# see src/neat_rag/config.py — every variable is documented there.

# ------------------------------------------------------------------------------
# LLM api key setting
# only used when you use cloud llm model providers.
# COHERE_API_KEY only used when you set RERANKER_PROVIDER=cohere
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

COHERE_API_KEY=

# ------------------------------------------------------------------------------
# PostgreSQL
# Use "postgres" for DB_HOST when running inside Docker Compose.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Redis  (use "redis://redis:6379/0" inside Docker Compose)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Vector Store
# "qdrant" (dedicated instance) | "pgvector" (integrated PostgreSQL)
# Use "qdrant" for QDRANT_HOST when running inside Docker Compose.
# ------------------------------------------------------------------------------
VECTOR_STORE_BACKEND=qdrant
QDRANT_HOST=localhost

# ------------------------------------------------------------------------------
# Admin bootstrap key — change to a strong secret before deploying.
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_KEY=admin

# ------------------------------------------------------------------------------
# Whether to turn on the knowledge base shared by all users
# When true, all API keys share a single dataset (user_id is never propagated to the DB).
# When false, each key owner sees only their own documents and sessions.
# ------------------------------------------------------------------------------
DATABASE_SHARED=true

# ------------------------------------------------------------------------------
# LLM  — set the provider and a model available for that provider.
#
# Cloud:  openai / gemini / anthropic / deepseek  (fill in the matching API key below)
# Local:  ollama  (no API key needed — set OLLAMA_BASE_URL if not using Docker)
#
# More setting examples are in src/neat_rag/config.py.
# For local dev (non-Docker), change OLLAMA_BASE_URL to http://localhost:11434
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# When true, vision-capable LLMs (e.g. gpt-4o, llava, qwen2-vl) receive images
# directly at inference time. Non-multimodal LLMs fall back to VLM description + OCR text.
LLM_MULTIMODAL=true

# ------------------------------------------------------------------------------
# Embeddings  — EMBEDDING_DIM must exactly match the model's output dimension.
#
# Cloud:   openai / gemini
# Local:   ollama  (bge-m3: 1024 dim, multilingual)
#
# More setting examples are in src/neat_rag/config.py.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# ------------------------------------------------------------------------------
# Chunking.
#
# Cloud:   openai / gemini
# Local:   ollama  (bge-m3)
#
# More setting examples are in src/neat_rag/config.py.
# ------------------------------------------------------------------------------
CHUNKING_PROVIDER=gemini
CHUNKING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# Reranker
# "bge" (BAAI/bge-reranker-v2-m3: local, no API key) | "cohere" (rerank-multilingual-v3.0: cloud, requires COHERE_API_KEY)
# More setting examples are in src/neat_rag/config.py
# ------------------------------------------------------------------------------
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-multilingual-v3.0
