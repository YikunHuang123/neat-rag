# Neat-RAG — minimum configuration to get started.
# Copy to .env and fill in your values:  cp .env.example .env
#
# For the full list of tuneable settings (retrieval, chunking, rate limits, etc.)
# see src/neat_rag/config.py — every variable is documented there.

# ------------------------------------------------------------------------------
# PostgreSQL
# Use "postgres" for DB_HOST when running inside Docker Compose.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Redis  (use "redis://redis:6379/0" inside Docker Compose)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Vector Store
# "qdrant" (dedicated instance) | "pgvector" (integrated PostgreSQL)
# Use "qdrant" for QDRANT_HOST when running inside Docker Compose.
# ------------------------------------------------------------------------------
VECTOR_STORE_BACKEND=qdrant
QDRANT_HOST=localhost

# ------------------------------------------------------------------------------
# Admin bootstrap key — change to a strong secret before deploying.
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_KEY=admin

# ------------------------------------------------------------------------------
# LLM  — set the provider and a model available for that provider.
#
# Cloud:  openai / gemini / anthropic / deepseek  (fill in the matching API key below)
# Local:  ollama  (no API key needed — set OLLAMA_BASE_URL if not using Docker)
#
# More setting examples are in src/neat_rag/config.py.
# For local dev (non-Docker), change OLLAMA_BASE_URL to http://localhost:11434
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# Embeddings  — EMBEDDING_DIM must exactly match the model's output dimension.
#
# Cloud:   openai / gemini / anthropic / deepseek
# Local:   ollama  (bge-m3: 1024 dim, multilingual)
#
# More setting examples are in src/neat_rag/config.py.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ------------------------------------------------------------------------------
# Reranker
# "bge" (local, no API key) | "cohere" (cloud, requires COHERE_API_KEY)
# More setting examples are in src/neat_rag/config.py
# ------------------------------------------------------------------------------
RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=
